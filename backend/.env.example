# ChronOS Backend Environment Configuration

# Application Mode
ENV=development
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional anchored, site-specific deploy-preview regex. Leave empty to disable.
BACKEND_CORS_ORIGIN_REGEX=
BACKEND_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Explicit local auth fallback. Never enable in production.
DEV_MODE=false
DEV_USER_ID=your_test_user_uuid_here

# Model gateway
# Backend ONLY. Never expose this to the frontend.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_FAST=configure_a_supported_fast_model
GROQ_MODEL_REASONING=configure_a_supported_reasoning_model
GROQ_MODEL_TOOL_USE=configure_a_supported_tool_model
MODEL_REQUEST_TIMEOUT_SECONDS=20
MODEL_MAX_RETRIES=1
WORKFLOW_MAX_STEPS=6
WORKFLOW_TIMEOUT_SECONDS=45
WORKFLOW_REQUEST_BUDGET=4
RUN_GROQ_INTEGRATION=0

# Embedding and knowledge context (backend only)
# local_hash is deterministic/offline. Use huggingface explicitly for semantic vectors.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api-inference.huggingface.co/pipeline/feature-extraction
EMBEDDING_DIMENSIONS=384
EMBEDDING_REQUEST_TIMEOUT_SECONDS=20
EMBEDDING_MAX_RETRIES=1
KNOWLEDGE_MAX_FILE_BYTES=5000000
CONTEXT_PACK_TOKEN_BUDGET=1800

# Supabase Database Configuration
# Obtain these by running `supabase status` in the root directory.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=your_anon_public_key_here
# Backend ONLY. The frontend must NEVER receive the service role key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Opt-in local integration tests (never point these at production).
RUN_SUPABASE_INTEGRATION=0
SUPABASE_TEST_URL=http://127.0.0.1:55321
SUPABASE_TEST_ANON_KEY=your_local_anon_key_here
SUPABASE_TEST_SERVICE_ROLE_KEY=your_local_service_role_key_here

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/auth/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly
FRONTEND_URL=http://localhost:5173
GOOGLE_OAUTH_STATE_SECRET=replace_with_a_backend_only_random_secret
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
INTEGRATION_REQUEST_TIMEOUT_SECONDS=15
INTEGRATION_MAX_RETRIES=1
INTEGRATION_MAX_PAGES=10
MCP_ALLOWED_SERVERS=[]
MCP_REQUEST_TIMEOUT_SECONDS=10
MCP_REQUEST_BUDGET=4
MODEL_CALLS_PER_HOUR_USER=30
MODEL_CALLS_PER_HOUR_GLOBAL=1000
EMBEDDING_CALLS_PER_HOUR_USER=60
EMBEDDING_CALLS_PER_HOUR_GLOBAL=3000
INGESTION_REQUESTS_PER_HOUR_USER=12
INGESTION_BYTES_PER_HOUR_USER=25000000
INTEGRATION_SYNCS_PER_HOUR_USER=12
MCP_CALLS_PER_HOUR_USER=60
PROPOSALS_PER_HOUR_USER=40
FAILED_APPROVALS_PER_HOUR_USER=10
RUN_GOOGLE_INTEGRATION=0
GOOGLE_TEST_USER_ID=uuid_of_a_disposable_vault_connected_test_user

# Security & Encryption
# 32-byte url-safe base64 key for encrypting Google connection OAuth tokens
ENCRYPTION_KEY=your_base64_encryption_key_here
